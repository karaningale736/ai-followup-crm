{
  "buildCommand": "mkdir -p public && cp backend/frontend/* public/ 2>/dev/null || true",
  "outputDirectory": "public",
 
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://your-render-backend.onrender.com/docs"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://your-render-backend.onrender.com/api/$1"
    }
  ]
}
